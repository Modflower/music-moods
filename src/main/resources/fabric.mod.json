{
	"schemaVersion": 1,
	"id": "music-moods",
	"version": "${version}",
	"name": "Music Moods",
	"description": "A highly configurable music engine with cross-fading, constant music, i.e. infinite with no delay, and uninterruptible music when pausing or switching worlds, allowing seamless transitions.",
	"contributors": [
		"HyperPigeon",
		"sisby-folk"
	],
	"authors": [
		"Ampflower"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/music-moods",
		"sources": "https://github.com/Modflower/music-moods",
		"issues": "https://github.com/Modflower/music-moods/issues"
	},
	"license": "MPL-2.0",
	"icon": "pack.png",
	"entrypoints": {
		"client": [
			"gay.ampflower.musicmoods.util.Platform::init"
		],
		"modmenu": [
			"gay.ampflower.musicmoods.client.MusicMoodsModMenuCompat"
		]
	},
	"depends": {
		"minecraft": "${minecraft_required}",
		"java": ">=${java}",
		"spruceui": "*"
	},
	"mixins": [
		"music-moods.mixin.json"
	],
	"environment": "client"
}
